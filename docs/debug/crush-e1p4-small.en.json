[
  {
    "start": 0.0,
    "end": 2.3,
    "text": " Ms. Lane, calm down. She's here to settle this."
  },
  {
    "start": 2.3,
    "end": 3.5,
    "text": " Let go!"
  },
  {
    "start": 5.5,
    "end": 7.5,
    "text": " I heard you're just a housewife."
  },
  {
    "start": 8.0,
    "end": 10.5,
    "text": " Judging by what you're wearing, you clearly need the money."
  },
  {
    "start": 10.5,
    "end": 12.5,
    "text": " You'd be lucky to get a million."
  },
  {
    "start": 14.0,
    "end": 15.5,
    "text": " I'm offering you two."
  },
  {
    "start": 15.5,
    "end": 17.5,
    "text": " That's more than fair."
  },
  {
    "start": 17.5,
    "end": 20.5,
    "text": " You should count yourself lucky I'm willing to be so generous."
  },
  {
    "start": 21.5,
    "end": 23.0,
    "text": " Your money means nothing."
  },
  {
    "start": 23.0,
    "end": 24.5,
    "text": " Yara hasn't woken up."
  },
  {
    "start": 24.5,
    "end": 26.5,
    "text": " Your son belongs in prison."
  },
  {
    "start": 26.5,
    "end": 28.0,
    "text": " Money means nothing."
  },
  {
    "start": 28.0,
    "end": 29.5,
    "text": " You know what they say?"
  },
  {
    "start": 30.0,
    "end": 32.0,
    "text": " Money makes problems disappear."
  },
  {
    "start": 32.0,
    "end": 34.0,
    "text": " Why do you think this never made the news?"
  },
  {
    "start": 34.0,
    "end": 36.0,
    "text": " I paid to have the whole thing buried."
  },
  {
    "start": 36.0,
    "end": 40.34,
    "text": " You know what this is?"
  },
  {
    "start": 40.34,
    "end": 41.34,
    "text": " A black card."
  },
  {
    "start": 41.34,
    "end": 43.34,
    "text": " Only the ultra-rich get one."
  },
  {
    "start": 43.34,
    "end": 45.34,
    "text": " That's the card I gave my husband."
  }
]