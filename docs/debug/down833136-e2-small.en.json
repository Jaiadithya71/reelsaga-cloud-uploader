[
  {
    "start": 0.0,
    "end": 2.28,
    "text": " Abe! Help me!"
  },
  {
    "start": 14.719999999999997,
    "end": 16.98,
    "text": " What the hell is going on?"
  },
  {
    "start": 19.76,
    "end": 21.16,
    "text": " He attacked me!"
  },
  {
    "start": 21.72,
