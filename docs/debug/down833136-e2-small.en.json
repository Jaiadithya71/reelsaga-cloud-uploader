  {
    "start": 23.84,
    "end": 24.76,
    "text": " I didn't ask you."
  },
  {
    "start": 30.08,
    "end": 31.38,
    "text": " They stole my cake!"
  },
  {
    "start": 32.04,
    "end": 33.4,
    "text": " And your gardener threatened me."
  },
  {
    "start": 33.82,
    "end": 34.84,
    "text": " That's not what happened."
  },
  {
    "start": 37.940000000000005,
    "end": 40.36,
    "text": " Touch her again, and you're fired."
  },
  {
    "start": 42.78,
    "end": 44.24,
    "text": " God, I want to break his face."
  },
  {
    "start": 44.68,
    "end": 46.4,
    "text": " But one punch could ruin everything."
  },
  {
    "start": 46.96,
    "end": 47.84,
    "text": " I came here to do."
  },
  {
    "start": 48.44,
    "end": 49.7,
    "text": " Enjoy this while you can, bastard."
  },
  {
    "start": 52.02,
    "end": 53.78,
    "text": " Soon, you'll pay for all of it."
  },
  {
    "start": 61.46,
    "end": 63.56,
    "text": " Daddy, it's my birthday too."
  },
  {
    "start": 65.32,
    "end": 66.82,
    "text": " Did you get me a present?"
  },
  {
    "start": 73.34,
    "end": 74.32,
    "text": " There's your present."
  },
  {
    "start": 76.7,
    "end": 77.84,
    "text": " It's all you deserve."
  },
  {
    "start": 81.08,
    "end": 82.64,
    "text": " Why don't you love me, daddy?"
  },
  {
    "start": 83.7,
    "end": 84.62,
    "text": " Because you're trash."
  },
  {
    "start": 85.54,
    "end": 86.38,
    "text": " Just like your mother."
  },
  {
    "start": 90.72,
    "end": 92.94,
    "text": " Don't you ever speak to her like that again."
  },
  {
    "start": 97.4,
    "end": 97.92,
    "text": " Careful."
  },
  {
    "start": 100.42,
    "end": 101.78,
    "text": " You live in my house."
  },
  {
    "start": 103.36,
    "end": 104.64,
    "text": " Because I allow it."
  },
  {
    "start": 106.06,
    "end": 107.58,
    "text": " This used to be my house too."
  },
  {
    "start": 110.46,
    "end": 111.22,
    "text": " Used to be."
  },
  {
    "start": 114.26,
